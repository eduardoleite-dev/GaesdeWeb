@page "/login"
@layout EmptyLayout
@inherits LoginPage

<PageTitle>Login | GaesdeWeb</PageTitle>

<div class="login-page">
    <section class="login-banner">
        <div class="banner-brand"><span class="brand-mark">A</span> ArquiteturaBase</div>
        <div class="banner-copy">
            <p class="eyebrow">@BannerEyebrow</p>
            <h1>@BannerTitle<br /><em>@BannerHighlight</em></h1>
            <p>@BannerDescription</p>
        </div>
        <div class="banner-stats">
            <div><strong>100%</strong><span>Base reutilizável</span></div>
            <div><strong>JWT</strong><span>Sessão protegida</span></div>
            <div><strong>.NET 10</strong><span>Pronto para evoluir</span></div>
        </div>
        <div class="banner-quote">“Uma base clara transforma o primeiro commit em um caminho seguro para crescer.”</div>
    </section>

    <section class="login-panel">
        <div class="login-panel-inner">
            <p class="eyebrow">ACESSO À APLICAÇÃO</p>
            <h2>Bem-vindo de volta</h2>
            <p class="login-subtitle">Acesse sua conta para continuar.</p>

            <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault>
                <label for="username">Usuário</label>
                <input id="username" @bind="username" autocomplete="username" placeholder="usuarioMaster" disabled="@loading" />

                <label for="password">Senha</label>
                <input id="password" type="password" @bind="password" autocomplete="current-password" placeholder="••••••••" disabled="@loading" />

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <p class="error" role="alert">@errorMessage</p>
                }

                <button class="button primary full-width" type="submit" disabled="@loading">
                    @(loading ? "Autenticando..." : "Entrar na aplicação")
                </button>
            </form>
        </div>
    </section>
</div>