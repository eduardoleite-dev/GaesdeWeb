@page "/courses"
@layout MainLayout
@inherits CoursesPage

<PageTitle>Cursos | GAESDE</PageTitle>

<main class="courses-page">
    <section class="courses-toolbar">
        <div>
            <p class="eyebrow">CATÁLOGO DO GAESDE</p>
            <h1>Cursos</h1>
            <p>Crie e organize experiências de aprendizagem.</p>
        </div>
        @if (CanManageCourses)
        {
            <button class="crud-button" @onclick="OpenCreateForm"><span aria-hidden="true">+</span> Adicionar curso</button>
        }
    </section>

    <form class="courses-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <label for="course-search">Buscar curso</label>
        <span aria-hidden="true">⌕</span>
        <input id="course-search" @bind="search" placeholder="Buscar por título..." disabled="@loading" />
        <button class="search-button" type="submit" aria-label="Buscar curso" title="Buscar curso" disabled="@loading">⌕</button>
    </form>

    @if (showForm)
    {
        <section class="course-form-panel">
            <div class="form-heading">
                <p class="eyebrow">@(editingId is null ? "NOVO CURSO" : "EDITAR CURSO")</p>
                <h2>@(editingId is null ? "Adicionar curso" : "Editar curso")</h2>
            </div>
            <form class="course-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <div class="form-field wide"><label for="course-title">Título</label><input id="course-title" @bind="title" placeholder="Ex.: Introdução à programação" disabled="@saving" /></div>
                <div class="form-field"><label for="course-slug">Slug</label><input id="course-slug" @bind="slug" placeholder="introducao-programacao" disabled="@saving" /></div>
                <div class="form-field"><label for="course-level">Nível</label><select id="course-level" @bind="level" disabled="@saving"><option value="Beginner">Iniciante</option><option value="Intermediate">Intermediário</option><option value="Advanced">Avançado</option></select></div>
                <div class="form-field"><label for="course-price">Preço</label><input id="course-price" type="number" min="0" step="0.01" @bind="price" disabled="@saving" /></div>
                <div class="form-field"><label for="course-category">Categoria</label><select id="course-category" @bind="categoryId" disabled="@saving"><option value="">Selecione...</option>@foreach (var category in Categories){<option value="@category.Id">@category.Name</option>}</select></div>
                <div class="form-field"><label for="course-instructor">Professor</label><select id="course-instructor" @bind="instructorId" disabled="@saving"><option value="">Selecione...</option>@foreach (var professor in Professors){<option value="@professor.Id">@professor.Name</option>}</select></div>
                <div class="form-field wide">
                    <label for="course-cover">Imagem de capa</label>
                    <InputFile id="course-cover" OnChange="SelectCover" accept="image/jpeg,image/png,image/webp,image/gif" disabled="@saving" />
                    @if (!string.IsNullOrWhiteSpace(selectedCoverName))
                    {
                        <small class="selected-file">@selectedCoverName</small>
                    }
                    else if (!string.IsNullOrWhiteSpace(coverImage))
                    {
                        <small class="selected-file">Capa atual cadastrada</small>
                    }
                </div>
                <div class="form-field wide"><label for="course-description">Descrição</label><textarea id="course-description" @bind="description" rows="3" placeholder="Descreva o que o aluno vai aprender..." disabled="@saving"></textarea></div>
                <div class="form-actions"><button class="crud-button" type="submit" disabled="@saving">@(saving ? "Salvando..." : "Salvar curso")</button><button class="plain-button" type="button" @onclick="CloseForm" disabled="@saving">Cancelar</button></div>
                @if (!string.IsNullOrWhiteSpace(formMessage)){<p class="error wide" role="alert">@formMessage</p>}
            </form>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="error" role="alert">@errorMessage</p>
    }
    else if (loading && Courses.Count == 0)
    {
        <p class="course-status">Carregando cursos...</p>
    }
    else if (Courses.Count == 0)
    {
        <section class="course-empty"><span aria-hidden="true">▣</span><h2>Nenhum curso encontrado</h2><p>Adicione o primeiro curso ou ajuste sua busca.</p></section>
    }
    else
    {
        <section class="course-list" aria-live="polite">
            <div class="course-list-header"><span>Curso</span><span>Categoria</span><span>Nível</span><span>Ações</span></div>
            @foreach (var course in Courses)
            {
                <div class="course-row">
                    <div class="course-title">
                        @if (!string.IsNullOrWhiteSpace(course.CoverImage))
                        {
                            <img class="course-cover-image" src="@course.CoverImage" alt="" />
                        }
                        <div><strong>@course.Title</strong><small>@course.Slug</small></div>
                    </div>
                    <span>@(Categories.FirstOrDefault(category => category.Id == course.CategoryId)?.Name ?? "Sem categoria")</span>
                    <span class="level-badge">@course.Level</span>
                    <div class="course-actions"><button class="plain-button" @onclick="() => OpenEditForm(course)">Editar</button><button class="plain-button danger" @onclick="() => DeleteAsync(course)">Excluir</button></div>
                </div>
            }
        </section>
        <nav class="course-pagination" aria-label="Paginação de cursos"><button class="pagination-button" @onclick="PreviousPageAsync" disabled="@(loading || Page <= 1)">← Anterior</button><span>Página <strong>@Page</strong> de @TotalPages</span><button class="pagination-button" @onclick="NextPageAsync" disabled="@(loading || Page >= TotalPages)">Próxima →</button></nav>
    }
</main>
