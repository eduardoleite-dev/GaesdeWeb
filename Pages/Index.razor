@page "/"
@inherits IndexPage

<PageTitle>Gaesde | Games, Estudo e Desenho</PageTitle>

<header class="app-topbar">
	<button class="menu-button" aria-label="Abrir menu">☰</button>
	<div class="search-box"><span>⌕</span><input placeholder="Buscar uma conversa..." aria-label="Buscar conversas" /></div>
	<div class="account-area">
		<span class="notification-dot">♧</span>
		<div class="account-divider"></div>
		<div class="avatar">@UserInitial</div>
		<div class="account-copy"><strong>@DisplayName</strong><span>@SessionData?.Role · nível @SessionData?.AccessLevel</span></div>
		<button class="logout-button" @onclick="LogoutAsync">Sair</button>
	</div>
</header>

<main class="dashboard-content">
	<section class="welcome-banner">
		<div>
			<p class="banner-date">GAESDE · Games, Estudo e Desenho</p>
			<h1>Olá, @DisplayName! <span>👋</span></h1>
			<p>Seu espaço de aprendizagem está pronto para a próxima pergunta.</p>
		</div>
		<button class="banner-action" @onclick="LoadPrivateAsync" disabled="@privateLoading || !HasSession">
			@(privateLoading ? "Pensando..." : "Continuar conversa →")
		</button>
	</section>

	<section class="dashboard-cards" aria-live="polite">
		<article class="dashboard-card card-public">
			<div class="card-symbol">◎</div>
			<span class="card-label">CONVERSA ABERTA</span>
			<h2>Explore um assunto</h2>
			<p>@(publicMessage ?? "Escolha um tema para começar a aprender.")</p>
			<button class="card-action" @onclick="LoadPublicAsync" disabled="@publicLoading">@(publicLoading ? "Carregando..." : "Explorar assunto")</button>
		</article>
		<article class="dashboard-card card-private">
			<div class="card-symbol">◆</div>
			<span class="card-label">SEU APRENDIZADO</span>
			<h2>Continue sua trilha</h2>
			<p>@(privateMessage ?? "Sua conversa personalizada aparece aqui.")</p>
			<button class="card-action" @onclick="LoadPrivateAsync" disabled="@privateLoading || !HasSession">@(privateLoading ? "Carregando..." : "Abrir conversa")</button>
		</article>
	</section>

	@if (!HasSession)
	{
		<p class="hint">A sessão não foi encontrada. <a href="/login">Entrar novamente</a></p>
	}
</main>
